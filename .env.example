# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bauth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bauth

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:4321

# OAuth - Google (fill these to enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (fill these to enable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Backend (console | smtp)
# console: log emails to terminal (default, no config needed)
# smtp: send via SMTP server
EMAIL_BACKEND=console

# SMTP (required if EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.yourserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM="Your App <no-reply@yourapp.com>"

# Authentication TTLs (Format: 1s, 5m, 1h, 1d)
ONE_TIME_CODE_TTL=1m
ONE_TIME_LINK_TTL=10m
INVITATION_EXPIRES_IN=2d

# Organization limits
ORGANIZATION_LIMIT=3
MEMBERSHIP_LIMIT=5

# Device Authorization
# Device code lifetime. Valid range: 1m–24h. Format: ^[0-9]+[smhd]$ (e.g. 30m, 1h).
DEVICE_CODE_EXPIRES_IN=30m
# Minimum token polling interval in seconds. Range: 1–3600.
DEVICE_CODE_INTERVAL=5
# Comma-separated list of allowed client_id values. Empty = allow all clients.
DEVICE_CODE_ALLOWED_CLIENTS=
