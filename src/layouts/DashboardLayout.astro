---
import '../styles/globals.css';
import { auth } from '../lib/auth';
import { DashboardShell } from '../components/dashboard-shell';
import ThemeScript from '../components/ThemeScript.astro';

interface Props {
  title?: string;
  requireAdmin?: boolean;
  breadcrumbs?: { label: string, href?: string }[];
}

const { title = 'Dashboard', requireAdmin = false, breadcrumbs } = Astro.props;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect('/sign-in');
}

const adminUserIds = (process.env.ADMIN_USER_IDS || '').split(',').map(v => v.trim()).filter(Boolean);
const isUserAdmin = session.user.role === 'admin' || adminUserIds.includes(session.user.id);

if (requireAdmin && !isUserAdmin) {
  return Astro.redirect('/');
}

async function gravatarUrl(email: string, size = 80) {
  const hash = await crypto.subtle.digest(
    'SHA-256',
    new TextEncoder().encode(email.trim().toLowerCase()),
  );
  const hex = Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('');
  return `https://www.gravatar.com/avatar/${hex}?s=${size}&d=mp`;
}

const user = {
  id: session.user.id,
  name: session.user.name || 'User',
  email: session.user.email || '',
  image: session.user.image || await gravatarUrl(session.user.email),
  role: isUserAdmin ? 'admin' : (session.user.role || 'user'),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body>
    <DashboardShell user={user} title={title} breadcrumbs={breadcrumbs} client:load>
      <slot />
    </DashboardShell>
  </body>
</html>
