---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { auth } from "../../../../lib/auth";
import { TeamDashboard } from "../../../../components/org/team-dashboard";
import type { OrgPermissions } from "../../../../lib/org-permissions";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect("/sign-in");
}

const { slug, teamId } = Astro.params;

if (!slug || !teamId) {
  return Astro.redirect("/");
}

let orgName = slug;
let teamName = "Team";
let initialOrg: any = null;
let initialTeamMembers: any[] = [];

try {
  const org = await auth.api.getFullOrganization({
    headers: Astro.request.headers,
    query: { organizationSlug: slug },
  });
  if (org) {
    orgName = org.name;
    initialOrg = org;
    const team = org.teams?.find((t: any) => t.id === teamId);
    if (team) teamName = team.name;
  }
  const members = await auth.api.listTeamMembers({
    headers: Astro.request.headers,
    query: { teamId },
  });
  if (members) initialTeamMembers = members;
} catch (e) {
  console.error("Failed to fetch organization for team", e);
}

const permissions: OrgPermissions = {
  organization: { update: false, delete: false },
  member: { create: false, update: false, delete: false },
  invitation: { create: false, cancel: false },
  team: { create: false, update: false, delete: false },
  ac: { read: false, create: false, update: false, delete: false },
  apiKey: { read: false, create: false, update: false, delete: false },
};

if (initialOrg) {
  const checks: Array<{
    path: keyof OrgPermissions;
    action: string;
    perm: Record<string, string[]>;
  }> = [
    { path: "team", action: "update", perm: { team: ["update"] } },
    { path: "team", action: "delete", perm: { team: ["delete"] } },
    { path: "member", action: "create", perm: { member: ["create"] } },
    { path: "member", action: "delete", perm: { member: ["delete"] } },
  ];

  const results = await Promise.allSettled(
    checks.map(({ perm }) =>
      auth.api.hasPermission({
        headers: Astro.request.headers,
        body: { organizationId: initialOrg.id, permissions: perm },
      }),
    ),
  );

  results.forEach((result, i) => {
    const { path, action } = checks[i];
    (permissions[path] as any)[action] =
      result.status === "fulfilled" && result.value?.success === true;
  });
}

const breadcrumbs = [
  { label: "Organization", href: "/" },
  { label: orgName, href: `/org/${slug}` },
  { label: teamName },
];
---

<DashboardLayout title={`Team: ${teamName}`} breadcrumbs={breadcrumbs}>
  <div
    class="flex flex-col gap-4 py-4 md:gap-8 md:py-8 px-4 lg:px-6 max-w-6xl w-full"
  >
    <TeamDashboard
      slug={slug}
      teamId={teamId}
      initialOrg={initialOrg}
      initialTeamMembers={initialTeamMembers}
      permissions={permissions}
      client:load
    />
  </div>
</DashboardLayout>
