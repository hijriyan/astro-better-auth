---
import BlankLayout from '../../layouts/BlankLayout.astro';
import { DeviceForm } from '../../components/device/device-form';
import { auth } from '../../lib/auth';

const session = await auth.api.getSession({ headers: Astro.request.headers });
const userCode = new URL(Astro.request.url).searchParams.get('user_code') ?? '';

if (!session) {
  return Astro.redirect(`/sign-in?callbackURL=${encodeURIComponent(userCode ? `/device?user_code=${encodeURIComponent(userCode)}` : '/device')}`);
}
---

<BlankLayout title="Device Authorization">
  <DeviceForm initialUserCode={userCode} client:load />
</BlankLayout>
