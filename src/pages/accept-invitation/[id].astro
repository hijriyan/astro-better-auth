---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { AcceptInvitationClient } from '../../components/org/accept-invitation-client';
import { auth } from '../../lib/auth';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect('/sign-in?callbackURL=' + encodeURIComponent(new URL(Astro.request.url).pathname));
}
---

<DashboardLayout title="Accept Invitation">
  <div class="flex items-center justify-center min-h-[60vh] px-4">
    <AcceptInvitationClient client:load invitationId={id} />
  </div>
</DashboardLayout>
