---
import BlankLayout from '../layouts/BlankLayout.astro';
import { SignInForm } from '../components/auth/sign-in-form';
import 'dotenv/config';

const socialProviders = {
  google: !!(import.meta.env.GOOGLE_CLIENT_ID && import.meta.env.GOOGLE_CLIENT_SECRET),
  github: !!(import.meta.env.GITHUB_CLIENT_ID && import.meta.env.GITHUB_CLIENT_SECRET),
};
---

<BlankLayout title="Sign In">
  <SignInForm socialProviders={socialProviders} client:load />
</BlankLayout>
